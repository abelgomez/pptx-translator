# Copy this file as ".env" and adjust the values for the provider you want
# to use. All variables are optional; if not set, the defaults shown in
# parentheses are used.

# --- Provider selection ---
# Supported providers: local | openai
# - local: no API key or internet required after the model is downloaded.
# - openai: any OpenAI-compatible API endpoint.
TRANSLATOR_PROVIDER=local
TRANSLATOR_REMOVE_AUDIO=false
TRANSLATOR_FLATTEN_INLINE_FORMATTING=false
TRANSLATOR_API_KEY=
TRANSLATOR_API_BASE_URL=https://api.openai.com/v1
TRANSLATOR_MODEL=gpt-4o-mini
TRANSLATOR_REQUEST_DELAY=0.4
TRANSLATOR_MAX_RETRIES=4
TRANSLATOR_RETRY_BACKOFF=2.0
TRANSLATOR_TIMEOUT=60

# --- Other ---
# CLI verbosity level: ERROR | WARNING | INFO | DEBUG (default: WARNING).
# The -v/-vv command-line flags always take precedence over this variable.
TRANSLATOR_LOG_LEVEL=WARNING

# Note: translation exceptions (e.g. "Practica {num} = Practical Lesson
# {num}") are not configured here; they are supplied as a separate text
# file via the "-e/--exceptions" command-line argument. See
# exceptions.example.txt and the README for details.
